NODE_ENV=development
CONTROL_PORT=3100
PUBLIC_APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://mirotalk:mirotalk@localhost:5432/mirotalk
REDIS_URL=redis://localhost:6379
CONTROL_TOKEN_SECRET=replace-with-at-least-32-random-characters
WEBHOOK_ENCRYPTION_KEY=replace-with-a-different-32-character-secret
ADMIN_API_KEY=replace-with-a-random-admin-api-key
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_INTERNAL_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
STORAGE_BACKEND=filesystem
LOCAL_STORAGE_PATH=/tmp/mirotalk-ephemeral
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
TRANSCRIPTION_STREAM=mirotalk:transcription:jobs
TRANSCRIPTION_RESULT_STREAM=mirotalk:transcription:results
WHISPER_BASE_URL=http://host.docker.internal:8000/v1
WHISPER_API_KEY=
WHISPER_MODEL=gpt-transcribe

# Optional live interpreter. Bangla -> English uses OpenAI Realtime in the browser.
# English -> Bangla additionally requires the translation profile and ElevenLabs.
OPENAI_API_KEY=
REALTIME_TRANSLATION_MODEL=gpt-realtime-translate
TRANSLATOR_AGENT_NAME=mirotalk-translator
ELEVEN_API_KEY=
TRANSLATION_STT_MODEL=gpt-live-transcribe
TRANSLATION_LLM_MODEL=gpt-5.6-luna
TRANSLATION_TTS_MODEL=eleven_v3_conversational
TRANSLATION_BN_VOICE_ID=
